# Copy to .env and fill in. .env is gitignored.
# No secrets belong here: Azure access uses Managed Identity locally via `az login`
# (DefaultAzureCredential) and OIDC in CI. These are endpoints and names only.

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Microsoft Foundry / Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_MAPPING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=evidence-chunks

# Table Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_TABLE_MAPPINGS=mappings
AZURE_TABLE_AUDIT=reviewaudit

# Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Retrieval configuration
RETRIEVAL_TOP_K=5
PROMPT_VERSION=v1
SCHEMA_VERSION=v1
